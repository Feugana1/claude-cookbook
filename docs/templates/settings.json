{
  "env": {
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "75",
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "600000",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "true"
  },
  "permissions": {
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(chown -R *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git commit *--no-verify*)",
      "Bash(git rebase -i *)",
      "Bash(git branch -D *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git config --global *)",
      "Bash(git config --system *)",
      "Bash(npm install -g *)",
      "Bash(pip install *)",
      "Bash(brew install *)",
      "Bash(gem install *)",
      "Bash(gh auth logout *)",
      "Bash(gh auth refresh *)",
      "Bash(gh release delete *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo archive *)",
      "Bash(gh secret delete *)",
      "Bash(gh secret set *)",
      "Bash(gh workflow disable *)",
      "Bash(gh workflow run *)",
      "Write(**/.env*)",
      "Edit(**/.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/precommit-check.sh\"",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"$CLAUDE_PROJECT_DIR/scripts/statusline.sh\"",
    "refreshInterval": 30
  }
}
